{
  "name": "concord",
  "private": true,
  "version": "0.1.0",
  "author": {
    "name": "arpitkjaiswal",
    "url": "https://github.com/arpitkjaiswal"
  },
  "contributors": [
    {
      "name": "arpitkjaiswal",
      "url": "https://github.com/arpitkjaiswal"
    }
  ],
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "serve -s dist -l tcp://0.0.0.0:${PORT:-3000} --no-clipboard",
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --experimental-strip-types tests/model.test.ts",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "lucide-react": "1.63.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "serve": "14.2.6"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
